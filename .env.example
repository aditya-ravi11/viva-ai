# Copy to .env and fill in. Never commit .env.

# ─── Anthropic (Claude Haiku 4.5 live + Sonnet 4.5 for corpus labeling) ───
ANTHROPIC_API_KEY=sk-ant-...

# ─── Deepgram (Nova-2 ASR + Aura TTS) ───
DEEPGRAM_API_KEY=

# ─── Clerk (auth) ───
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# ─── Database (Postgres + pgvector) ───
# Local dev via docker-compose: see docker-compose.yml
DATABASE_URL=postgresql://aditya:dev_only_password@localhost:5432/mock_interviewer

# ─── Redis (sessions + Celery broker) ───
REDIS_URL=redis://localhost:6379/0

# ─── Cloudflare R2 (audio chunks + resume PDFs) ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mock-interviewer-audio
R2_ENDPOINT=

# ─── Modal (GPU jobs: FT eval inference, prosody features, retraining) ───
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ─── App URLs ───
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
